# 服务器初始化时复制为 /opt/xiaolvshu/docker/prod/.env 并替换全部占位值。
# 真实文件只保存在服务器，不提交 Git，也不由 GitHub Actions 覆盖。

TZ=Asia/Shanghai

# 腾讯云个人版 TCR
TCR_REGISTRY=ccr.ccs.tencentyun.com
TCR_NAMESPACE=replace_with_tcr_namespace

# Compose 配置校验需要默认标签；实际发布时工作流会用不可变 sha-* 标签覆盖。
# 因此前两个占位标签无需手工修改，也绝不会作为生产部署版本。
BACKEND_IMAGE_TAG=sha-000000000000
FRONTEND_IMAGE_TAG=sha-000000000000
FRONTEND_PORT=18080

# MySQL（数据库名由结构文件固定为 xiaolvshu）
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password
DB_USERNAME=xiaolvshu
DB_PASSWORD=replace_with_strong_database_password

# Redis
REDIS_DB=0
REDIS_TIMEOUT=5s

# RabbitMQ
RABBITMQ_USERNAME=xiaolvshu
RABBITMQ_PASSWORD=replace_with_strong_rabbitmq_password
RABBITMQ_VHOST=/

# Elasticsearch
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace_with_strong_elasticsearch_password

# 应用安全
JWT_SECRET=replace_with_at_least_32_random_bytes
# 替换为正式 HTTPS 主域名和 www 域名，使用英文逗号分隔。
APP_CORS_ALLOWED_ORIGINS=replace_with_https_origins
APP_LOG_LEVEL=INFO
API_DOCS_ENABLED=false

# 腾讯云 COS
COS_SECRET_ID=replace_with_cos_secret_id
COS_SECRET_KEY=replace_with_cos_secret_key
COS_REGION=ap-beijing
COS_BUCKET_NAME=replace_with_cos_bucket
COS_BASE_URL=

# 阿里云 DashScope / Spring AI
AI_API_KEY=replace_with_ai_api_key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_TEMPERATURE=0.3
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024

# 2 核 4G 默认只允许两个 Agent 请求同时占用模型长连接与检索资源。
AGENT_MAX_CONCURRENT=2
AGENT_HEARTBEAT_SECONDS=15
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_MAX_TOOL_CALLS=1
AGENT_RATE_LIMIT_PERIOD_SECONDS=60
AGENT_RATE_LIMIT_ANONYMOUS_MAX=5
AGENT_RATE_LIMIT_AUTHENTICATED_MAX=20
AGENT_MEMORY_MAX_MESSAGES=20
AGENT_MEMORY_RETENTION_DAYS=30
AGENT_MEMORY_CLEANUP_CRON=0 30 3 * * *

# RAG / Search
SEARCH_INDEX_PREFIX=xiaolvshu
RAG_INDEX_PREFIX=xiaolvshu
RAG_VECTOR_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=10
RAG_NUM_CANDIDATES=100
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.45
RAG_BM25_MIN_SCORE=2.0
RAG_BM25_STRONG_SCORE=12.3
RAG_VECTOR_STRONG_SIMILARITY=0.55
RAG_CANDIDATE_COUNT=30
RAG_RRF_RANK_CONSTANT=60
RAG_MAX_CHUNKS_PER_POST=2
