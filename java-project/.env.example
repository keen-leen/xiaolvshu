# Backend development environment variables
# Copy this file to .env.dev and fill in the secrets:
# cp java-project/.env.example java-project/.env.dev
# Do NOT commit real secrets.

# MySQL (must match docker/dev/.env)
DB_URL=jdbc:mysql://localhost:13306/xiaolvshu?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=xiaolvshu
DB_PASSWORD=replace_with_db_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_DB=0
REDIS_TIMEOUT=5s

# RabbitMQ (must match docker/dev/.env)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=15672
RABBITMQ_USERNAME=xiaolvshu
RABBITMQ_PASSWORD=replace_with_rabbitmq_password
RABBITMQ_VHOST=/

# JWT
JWT_SECRET=replace_with_strong_jwt_secret

# Elasticsearch (must match docker/dev/.env)
ELASTICSEARCH_URIS=http://localhost:19200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace_with_elasticsearch_password

# Search and RAG
SEARCH_INDEX_PREFIX=xiaolvshu
RAG_INDEX_PREFIX=xiaolvshu
RAG_VECTOR_DIMENSIONS=1024
RAG_NUM_CANDIDATES=100
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.45
RAG_AUTO_SYNC_ON_STARTUP=false

# AI
AI_API_KEY=replace_with_ai_api_key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_CHAT_MODEL=qwen-plus
AI_TEMPERATURE=0.3
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024

# COS
COS_SECRET_ID=replace_with_cos_secret_id
COS_SECRET_KEY=replace_with_cos_secret_key
COS_REGION=ap-beijing
COS_BUCKET_NAME=xiaolvshu-1310922207
COS_BASE_URL=

# Frontend development origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
APP_LOG_LEVEL=DEBUG
