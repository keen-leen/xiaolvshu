# Copy to .env before starting the development infrastructure:
# cp docker/dev/.env.example docker/dev/.env

TZ=Asia/Shanghai

MYSQL_PORT=13306
MYSQL_DATABASE=xiaolvshu
MYSQL_USER=xiaolvshu
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password

REDIS_PORT=16379

RABBITMQ_AMQP_PORT=15672
RABBITMQ_MANAGEMENT_PORT=25672
RABBITMQ_USER=xiaolvshu
RABBITMQ_PASSWORD=replace_with_rabbitmq_password

ELASTICSEARCH_PORT=19200
ELASTICSEARCH_PASSWORD=replace_with_elasticsearch_password
ELASTICSEARCH_HEAP=1g
